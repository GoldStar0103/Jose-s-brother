{
    "name": "@monkei/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./schema": "./src/schema.ts"
    },
    "scripts": {
        "generate": "drizzle-kit generate",
        "migrate": "drizzle-kit migrate",
        "studio": "drizzle-kit studio",
        "seed": "tsx src/seed.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@monkei/engine": "workspace:*",
        "@monkei/provider": "workspace:^",
        "@monkei/shared": "workspace:*",
        "drizzle-orm": "^0.36.0",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "@types/node": "^22",
        "drizzle-kit": "^0.28.0",
        "embedded-postgres": "18.4.0-beta.17",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^2.1.4"
    }
}

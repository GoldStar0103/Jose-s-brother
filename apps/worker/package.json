{
    "name":  "@levelup/worker",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "start":  "pnpm run pre-start && node ../../scripts/with-root-env.mjs tsx src/main.ts",
                    "dev":  "pnpm run pre-start && node ../../scripts/with-root-env.mjs tsx watch src/main.ts",
                    "pre-start":  "node ../../scripts/with-root-env.mjs pnpm --filter @levelup/db migrate && node ../../scripts/with-root-env.mjs tsx src/sync-catalog.ts",
                    "seed-test-order":  "node ../../scripts/with-root-env.mjs tsx src/seed-test-order.ts",
                    "reject-payment":  "node ../../scripts/with-root-env.mjs tsx src/reject-payment.ts",
                    "resume-order":  "node ../../scripts/with-root-env.mjs tsx src/resume-order.ts",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "sync-catalog":  "node ../../scripts/with-root-env.mjs tsx src/sync-catalog.ts"
                },
    "dependencies":  {
                         "@levelup/db":  "workspace:*",
                         "@levelup/engine":  "workspace:*",
                         "@levelup/provider":  "workspace:*",
                         "@levelup/shared":  "workspace:*",
                         "drizzle-orm":  "^0.36.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^22",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.6.3",
                            "vitest":  "^2.1.4"
                        }
}
